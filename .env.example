# ===== Quartet Web — Environment Variables =====
# Copy file ini ke .env (jangan commit .env asli) dan isi sesuai kebutuhan.

# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Database (Postgres) ---
DATABASE_URL=postgres://quartet:quartet@localhost:5432/quartet

# --- Cache (Redis) ---
REDIS_URL=redis://localhost:6379

# --- Game tuning ---
ROOM_EXPIRY_MINUTES=30
BLUFF_WINDOW_MS=5000
MAX_PLAYERS=6
MIN_PLAYERS=2