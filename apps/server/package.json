{
  "name": "@quartet/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quartet Web backend — Fastify REST + WebSocket game server (Phase 0 scaffold)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "echo \"migrations pending — phase 1+\"",
    "db:seed": "echo \"seed pending — phase 1+\""
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.12.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.12",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "vitest": "^2.0.5"
  }
}